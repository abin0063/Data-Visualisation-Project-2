{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Preferred Payment Methods Among Australian",
    "color": "black",
    "fontSize": 18,
    "fontWeight": "bold",
    "anchor": "middle",
    "dy": -10
  },
  "width": 368,
  "height": 335,
  "data": { "url": "data/waffle_payment_data.csv" },
  "params": [
    {
      "name": "methodSelector",
      "value": "All",
      "bind": {
        "input": "select",
        "options": ["All", "Bank Transfers", "Buy Now Pay Later", "Credit Card", "Debit Card", "Digital Wallet", "Other"],
        "name": "Highlight Method: "
      }
    }
  ],
  "mark": { "type": "rect", "stroke": "white", "strokeWidth": 2 },
  "encoding": {
    "x": { "field": "x", "type": "ordinal", "axis": null },
    "y": { "field": "y", "type": "ordinal", "axis": null },
    "color": {
      "condition": {
        "test": "methodSelector == 'All' || datum.method == methodSelector",
        "field": "method",
        "type": "nominal",
        "legend": {
          "title": "Payment Methods"
        },
        "scale": {
          "range": ["#E69F00", "#56B4E9", "#009E73", "#F0E442", "#0072B2", "#D55E00"]
        }
      },
      "value": "#E5E7EB"
    },
    "opacity": {
      "condition": {
        "test": "methodSelector == 'All' || datum.method == methodSelector",
        "value": 1
      },
      "value": 0.3
    },
    "tooltip": [
      { "field": "method", "type": "nominal", "title": "Payment Method" }
    ]
  },
  "config": { "view": { "stroke": null } }
}